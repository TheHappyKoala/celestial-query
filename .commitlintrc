{
  "extends": [
    "@commitlint/config-conventional"
  ],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "chore",
        "ci",
        "build",
        "revert",
        "hotfix"
      ]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "deps",
        "config",
        "ui",
        "backend",
        "frontend",
        "docs",
        "build",
        "ci",
        "tests",
        "release"
      ]
    ],
    "subject-case": [
      2,
      "always",
      "lower-case"
    ],
    "header-max-length": [
      2,
      "always",
      72
    ],
    "footer-max-line-length": [
      2,
      "always",
      100
    ],
    "body-max-line-length": [
      2,
      "always",
      100
    ]
  }
}
