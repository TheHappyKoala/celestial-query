{
  "name": "celestial-query",
  "version": "0.1.2",
  "description": "Query the state vectors of solar system and exoplanets",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "jest --coverage",
    "lint": "eslint --ext .ts .",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(ts|json)\"",
    "prepare": "husky",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "bin": {
    "celestial-query": "./dist/bin/index.js"
  },
  "_moduleAliases": {
    "src": "dist/src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheHappyKoala/celestial-query.git"
  },
  "keywords": [
    "planet",
    "vectors",
    "astronomy",
    "space"
  ],
  "author": "Darrell Arjuna Huffman",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/TheHappyKoala/celestial-query/issues"
  },
  "homepage": "https://github.com/TheHappyKoala/celestial-query#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.22.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.10",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.0",
    "module-alias": "^2.2.3",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.1",
    "yargs": "^17.7.2"
  }
}
